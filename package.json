{
  "name": "dataverse-component-inspector",
  "displayName": "Dataverse Component Inspector",
  "description": "Inline annotations for Dataverse GUIDs inside solution XML files.",
  "version": "0.0.1",
  "publisher": "inlineexplorer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://example.com/Inline-Explorer-designed-for-Dataverse.git"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:dataverse.login",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dataverse.login",
        "title": "Dataverse: Login"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "lint": "eslint .",
    "prepare": "npm run compile",
    "test": "npm run test:unit",
    "test:unit": "mocha --require ts-node/register --require tests/setup.ts \"tests/unit/**/*.spec.ts\"",
    "test:integration": "mocha --require ts-node/register --require tests/setup.ts \"tests/integration/**/*.spec.ts\"",
    "test:coverage": "c8 -o coverage --reporter=text --reporter=lcov npm run test:unit",
    "test:ci": "npm run lint && npm run test:coverage && npm run test:integration"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/mock-require": "^3.0.0",
    "@types/node": "^18.19.3",
    "@types/node-fetch": "^2.6.13",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.84.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "c8": "^10.1.3",
    "chai": "^6.2.0",
    "eslint": "^8.57.0",
    "mocha": "^11.7.4",
    "mock-require": "^3.0.3",
    "sinon": "^21.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@azure/msal-node": "^2.6.4",
    "node-fetch": "^2.6.9"
  }
}
