{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "outDir": "build/tests",
    "rootDir": ".",
    "lib": ["es2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "build"]
}
